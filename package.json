{
  "name": "midiy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build:core": "npm run build --workspace @midiy/mikro-core",
    "prestart": "npm run build:core",
    "start": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "pretest": "npm run build:core",
    "test": "node --import tsx --test test/*.test.js test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:core && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": { "@midiy/mikro-core": "*" },
  "devDependencies": {
    "@types/w3c-web-hid": "^1.0.6",
    "@types/webmidi": "^2.0.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
